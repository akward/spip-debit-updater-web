# Salin nilai ASLI hanya ke Vercel → Settings → Environment Variables
# Jangan commit file .env / kredensial / ID spreadsheet nyata ke GitHub.

# JSON service account Google (satu baris). Contoh bentuk saja — ganti dengan milik Anda.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","client_email":"YOUR_SA@YOUR_PROJECT.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# ID spreadsheet Google (dari URL: docs.google.com/spreadsheets/d/<ID>/edit)
# Ganti placeholder di bawah dengan ID nyata HANYA di Vercel, bukan di repo.
SHEET_DEBIT=YOUR_SHEET_ID_DEBIT
SHEET_UE=YOUR_SHEET_ID_UE
SHEET_KK=YOUR_SHEET_ID_KK
SHEET_ACQUIRER_TRX=YOUR_SHEET_ID_ACQUIRER_TRX
SHEET_ACQUIRER_EDC=YOUR_SHEET_ID_ACQUIRER_EDC
SHEET_FRAUD_BANK=YOUR_SHEET_ID_FRAUD_BANK
SHEET_FRAUD_PENYEBAB=YOUR_SHEET_ID_FRAUD_PENYEBAB
SHEET_PROP_CHANNEL=YOUR_SHEET_ID_PROP_CHANNEL
SHEET_SPASIAL_ATM=YOUR_SHEET_ID_SPASIAL_ATM
SHEET_SPASIAL_UE=YOUR_SHEET_ID_SPASIAL_UE
SHEET_SPASIAL_KK=YOUR_SHEET_ID_SPASIAL_KK
